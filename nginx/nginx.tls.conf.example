# Example TLS front for QR Guard (HTTPS + WSS + HSTS).
# Use this if nginx itself terminates TLS. If a managed edge (Cloudflare, ALB, Caddy, Traefik...)
# terminates TLS, apply the equivalent settings there and keep nginx.conf on the private network.
#
# 1. cp nginx/nginx.tls.conf.example nginx/nginx.tls.conf  and replace qrguard.example.com
# 2. In docker-compose.yml (pwa-frontend):
#      ports:   "443:443" and "80:80"   (80 only redirects)
#      volumes: ./nginx/nginx.tls.conf:/etc/nginx/conf.d/default.conf:ro
#               /etc/letsencrypt:/etc/letsencrypt:ro
#    (the snippets qrguard_common.conf / qrguard_server.conf / security_headers.conf are
#     already mounted for the HTTP config and are reused unchanged here)
# 3. Set CORS_ALLOWED_ORIGINS=https://qrguard.example.com in .env
#
# HSTS and the wss-only CSP come from the $qrg_hsts / $qrg_ws_src maps in qrguard_common.conf:
# they switch on automatically because $scheme is "https" in the 443 server below.

include /etc/nginx/snippets/qrguard_common.conf;

server {
    listen 80;
    server_name qrguard.example.com;
    server_tokens off;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name qrguard.example.com;

    ssl_certificate     /etc/letsencrypt/live/qrguard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qrguard.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:QRG_TLS:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    include /etc/nginx/snippets/qrguard_server.conf;
}
