# QR Guard Environment Variables Template
# Copy this file to .env and adjust. NEVER commit .env.
#
# Secrets are NOT stored here in production. Generate them with:
#     python scripts/generate_secrets.py
# which creates Docker secret files under ./secrets/ (git-ignored, excluded from the image):
#     secrets/redis_url            -> injected as REDIS_URL_FILE
# For local runs without Docker you may set the plain variables below instead.

# ── Runtime ──
ENVIRONMENT=production
ENABLE_API_DOCS=false
# Only set to false for plain-http local development (cookies then work without HTTPS).
SESSION_COOKIE_SECURE=true
# Exact origins allowed for CORS/WebSocket (comma separated). No wildcard.
CORS_ALLOWED_ORIGINS=https://qrguard.example.com

# ── Secrets (local, non-Docker use only) ──
# REDIS_URL=redis://qrguard:<password>@localhost:6379/0

# ── Threat Intelligence (Local IOC Feed Only) ──
# Max seconds a job may wait in the queue before the worker rejects it (SERVICE_UNAVAILABLE).
JOB_QUEUE_MAX_WAIT_SECONDS=300
# Optional local IOC feed + pinned SHA-256 (feed is rejected if the digest does not match)
TI_LOCAL_FEED_PATH=/app/ti_feed/ioc_feed.jsonl
TI_LOCAL_FEED_SHA256=

# ── ML Sensor & QR Decoder ──
QR_DECODE_MODE=fast

# ── Retention (seconds) ──
RESULT_CACHE_TTL=3600
FILE_RESULT_CACHE_TTL=1800
ORPHAN_FILE_MAX_AGE_SECONDS=900

# ── Abuse & Admission Limits ──
MAX_FILE_SIZE_MB=50
MAX_ACTIVE_JOBS_PER_SESSION=3
# Concurrent jobs per client network (IPv4 / IPv6 /64), cookie-independent. 0 disables.
MAX_ACTIVE_JOBS_PER_CLIENT=8
MAX_GLOBAL_ACTIVE_JOBS=40
TRUST_PROXY_HEADERS=true
MAX_STREAMS_PER_SESSION=6
MAX_PDF_PAGES=10
